# ./scripts/setup.sh generates .env with random local database passwords.
MYSQL_DATABASE=service_monitor
MYSQL_USER=monitor
MYSQL_PASSWORD=change-me-app-password
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_PORT=23306
REDIS_PORT=26379
KAFKA_PORT=29092
BACKEND_PORT=18180
FRONTEND_PORT=15273
MONITOR_INGEST_API_KEY=change-me-ingest-key

# Alerts: minimum sample size, thresholds, and per-service/type suppression period.
MONITOR_ALERTS_ENABLED=true
MONITOR_ALERT_MINIMUM_REQUESTS=10
MONITOR_ALERT_ERROR_RATE_PERCENT=10
MONITOR_ALERT_AVERAGE_DURATION_MS=500
MONITOR_ALERT_COOLDOWN_SECONDS=600

# Gmail: enable only after setting addresses and a Google app password (not the account password).
MONITOR_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLED=true
SMTP_SSL_ENABLED=false
MONITOR_EMAIL_FROM=
MONITOR_EMAIL_TO=
MONITOR_EMAIL_MAX_ATTEMPTS=5
MONITOR_EMAIL_RETRY_DELAY_SECONDS=30

